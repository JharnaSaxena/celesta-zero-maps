{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/earth",
      "destination": "/earth.html"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ]
}
